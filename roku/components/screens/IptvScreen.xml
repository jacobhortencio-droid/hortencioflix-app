        <Label id="hint" translation="[80,1020]" width="1760" font="font:SmallestSystemFont" color="0x6E717AFF"
            text="OK em «Listas» para mudar de fonte · * num canal: favoritos, guia, n.º do canal, verificar offline · No canal: Cima/Baixo muda" />
        <Label id="epg" translation="[680,975]" width="1180" font="font:SmallSystemFont" color="0xE6E7EAFF" />
        <Timer id="epgTimer" duration="0.7" repeat="false" />
        <MenuPanel id="menu" />
    </children>
</component>
