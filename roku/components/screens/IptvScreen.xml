<?xml version="1.0" encoding="utf-8" ?>
<component name="IptvScreen" extends="Group">
    <interface>
        <field id="start" type="boolean" onChange="onStart" />
        <field id="playRequest" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/utils/Crash.brs" />
    <script type="text/brightscript" uri="pkg:/components/utils/Config.brs" />
    <script type="text/brightscript" uri="pkg:/components/utils/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/IptvScreen.brs" />
    <children>
        <Label id="header" text="TV ao vivo" translation="[80,48]" width="1200" font="font:LargeBoldSystemFont" color="0xE50914FF" />
        <Label id="summary" translation="[80,112]" width="1760" font="font:SmallSystemFont" color="0x8A8D96FF" />
        <Rectangle translation="[60,160]" width="580" height="840" color="0x181A20FF" />
        <LabelList id="groups" translation="[80,180]" itemSize="[540,56]" numRows="14"
