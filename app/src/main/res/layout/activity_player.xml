<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true" />

    <!-- A carregar -->
    <LinearLayout
        android:id="@+id/loading_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.hortencioflix.tv.ui.HfLoader
            android:id="@+id/loading_spin"
            android:layout_width="56dp"
            android:layout_height="56dp" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:maxWidth="520dp"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="@color/text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Barra superior: título e ações -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/top_title"
            android:fontFamily="@font/hf_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/top_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_lock"
            style="@style/PlayerChip"
            android:text="🔒" />

        <TextView
            android:id="@+id/btn_subs"
            style="@style/PlayerChip"
            android:text="Legendas" />

        <TextView
            android:id="@+id/btn_audio"
            style="@style/PlayerChip"
            android:text="Áudio" />

        <TextView
            android:id="@+id/btn_sources"
            style="@style/PlayerChip"
            android:text="Fontes" />

        <TextView
            android:id="@+id/btn_more"
            style="@style/PlayerChip"
            android:text="⋯" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_next"
        style="@style/PlayerChip"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="110dp"
        android:text="Próximo episódio  ▶"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_unlock"
        style="@style/PlayerChip"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="24dp"
        android:text="🔓  Desbloquear"
        android:visibility="gone" />

    <!-- Próximo episódio (contagem) -->
    <LinearLayout
        android:id="@+id/next_card"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/osd_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/next_thumb"
                android:layout_width="112dp"
                android:layout_height="63dp"
                android:background="@drawable/poster_bg"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/next_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/hfAccent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/next_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView android:id="@+id/next_cancel" style="@style/PlayerChip" android:text="Cancelar" />
            <TextView android:id="@+id/next_now" style="@style/PlayerChip" android:text="▶  Ver já" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="120dp"
        android:background="@drawable/osd_bg"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/skip_hint"
        style="@style/PlayerChip"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="160dp"
        android:text="Saltar introdução  ⏭"
        android:visibility="gone" />
</FrameLayout>
